# Next.js — browser-visible API origin.
# NEXT_PUBLIC_* values are embedded into the browser bundle at build time.
# Never include secrets in these values.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Explicit production-artifact delivery over local loopback HTTP.
# Use true only with NODE_ENV=production and a loopback API origin.
# External production requires HTTPS and this option set to false.
LOCAL_CONTAINER_DELIVERY=false