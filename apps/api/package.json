{
    "name": "@typing-analytics/api",
    "version": "0.1.0",
    "private": true,
    "description": "",
    "author": "",
    "license": "UNLICENSED",
    "type": "module",
    "scripts": {
        "build": "nest build --rspackPath rspack.config.cjs",
        "prebuild": "prisma generate",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start --rspackPath rspack.config.cjs",
        "start:dev": "nest start --watch --rspackPath rspack.config.cjs",
        "start:debug": "nest start --debug --watch --rspackPath rspack.config.cjs",
        "start:prod": "node dist/main.js",
        "lint": "oxlint src/ test/",
        "typecheck": "tsc --noEmit",
        "pretypecheck": "prisma generate",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:cov": "vitest run --coverage",
        "test:integration": "vitest run --config ./vitest.config.integration.ts",
        "pretest:integration": "prisma generate",
        "prisma:generate": "prisma generate",
        "prisma:validate": "prisma validate",
        "prisma:migrate:dev": "prisma migrate dev",
        "prisma:migrate:deploy": "prisma migrate deploy",
        "prisma:migrate:test": "prisma migrate deploy --config prisma7.integration.config.ts"
    },
    "dependencies": {
        "@nestjs/common": "^12.0.1",
        "@nestjs/config": "12.0.1",
        "@nestjs/core": "^12.0.1",
        "@nestjs/jwt": "12.0.1",
        "@nestjs/platform-express": "^12.0.1",
        "@prisma/adapter-pg": "7.10.0",
        "@prisma/client": "7.10.0",
        "@typing-analytics/typing-core": "workspace:*",
        "class-transformer": "0.5.1",
        "class-validator": "0.15.1",
        "dotenv": "18.0.3",
        "pg": "8.23.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1"
    },
    "devDependencies": {
        "@nestjs/cli": "^12.0.0",
        "@nestjs/schematics": "^12.0.0",
        "@nestjs/testing": "^12.0.1",
        "@rspack/core": "2.2.7",
        "@types/express": "^5.0.0",
        "@types/node": "^24.0.0",
        "@types/pg": "8.23.1",
        "@types/supertest": "7.2.1",
        "@vitest/coverage-v8": "^4.1.2",
        "oxlint": "^1.58.0",
        "oxlint-tsgolint": "^7.0.2001",
        "prettier": "^3.4.2",
        "prisma": "7.10.0",
        "source-map-support": "^0.5.21",
        "supertest": "7.3.0",
        "tsconfig-paths-webpack-plugin": "4.2.0",
        "typescript": "^6.0.2",
        "vitest": "^4.1.2",
        "webpack-node-externals": "3.0.0"
    }
}
