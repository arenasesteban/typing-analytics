
# NestJS — development
# Explicit runtime environment.
NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:3000

# Explicit local production-artifact delivery over loopback HTTP.
# Requires NODE_ENV=production and WEB_ORIGIN using localhost or loopback.
# Must remain false for externally deployed production environments.
LOCAL_CONTAINER_DELIVERY=false

# Authentication
# Set a unique secret of at least 32 bytes in apps/api/.env.
# Never use test secrets or commit the real value.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Prisma / PostgreSQL — local development
DATABASE_URL=postgresql://typing_analytics:typing_analytics_local@localhost:5433/typing_analytics?schema=public

# MongoDB — local development
MONGODB_URL=mongodb://127.0.0.1:27017
MONGODB_DB=typing_analytics

# Event delivery — enabled in development
EVENT_DELIVERY_AUTOSTART=true
