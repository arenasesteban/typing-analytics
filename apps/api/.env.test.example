
# NestJS — isolated integration tests
NODE_ENV=test
PORT=3002
WEB_ORIGIN=http://localhost:3000

# Authentication — test-only values
# Never reuse this secret outside the test environment.
JWT_ACCESS_SECRET=typing-analytics-test-access-secret-0123456789abcdef
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Prisma / PostgreSQL — isolated test database
DATABASE_URL=postgresql://typing_analytics:typing_analytics_test_local@localhost:5434/typing_analytics_test?schema=public

# MongoDB — isolated test database
MONGODB_URL=mongodb://127.0.0.1:27018
MONGODB_DB=typing_analytics_test

# Event delivery — controlled by integration tests
EVENT_DELIVERY_AUTOSTART=false
