{
    "name": "typing-analytics",
    "version": "0.1.0",
    "private": true,
    "packageManager": "pnpm@12.6.0",
    "engines": {
        "node": ">=24.21.0 <25"
    },
    "scripts": {
        "dev": "pnpm dev:web",
        "dev:web": "pnpm --filter @typing-analytics/web dev",
        "dev:api": "pnpm --filter @typing-analytics/api dev",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "lint": "pnpm -r --if-present lint",
        "typecheck": "pnpm -r --if-present typecheck",
        "build": "pnpm -r --if-present build",
        "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
        "test": "pnpm -r --if-present test",
        "test:integration": "pnpm --filter @typing-analytics/api test:integration",
        "test:e2e": "pnpm e2e:db:reset && pnpm e2e:db:generate && pnpm e2e:db:migrate && pnpm --filter @typing-analytics/web test:e2e",
        "test:e2e:headed": "pnpm e2e:db:reset && pnpm e2e:db:generate && pnpm e2e:db:migrate && pnpm --filter @typing-analytics/web test:e2e:headed",
        "db:up": "docker compose up -d --wait postgres mongo",
        "db:down": "docker compose down",
        "db:reset": "docker compose down -v",
        "db:validate": "pnpm --filter @typing-analytics/api prisma:validate",
        "db:generate": "pnpm --filter @typing-analytics/api prisma:generate",
        "db:migrate": "pnpm --filter @typing-analytics/api prisma:migrate:dev",
        "db:migrate:deploy": "pnpm --filter @typing-analytics/api prisma:migrate:deploy",
        "integration:db:up": "docker compose --profile test up -d --wait postgres-test mongo-test",
        "integration:db:down": "docker compose --profile test down",
        "integration:db:reset": "docker compose --profile test down -v",
        "integration:db:migrate": "pnpm --filter @typing-analytics/api prisma:migrate:integration",
        "e2e:db:reset": "docker compose --profile e2e rm -sf postgres-e2e mongo-e2e && docker compose --profile e2e up -d --wait postgres-e2e mongo-e2e",
        "e2e:db:generate": "pnpm --filter @typing-analytics/api prisma:generate:e2e",
        "e2e:db:migrate": "pnpm --filter @typing-analytics/api prisma:migrate:e2e",
        "e2e:db:down": "docker compose --profile e2e rm -sf postgres-e2e mongo-e2e"
    },
    "devDependencies": {
        "prettier": "3.9.9",
        "prettier-plugin-tailwindcss": "^0.8.1"
    }
}
